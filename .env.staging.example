# Variables pour docker-compose.yml — ENVIRONNEMENT DE STAGING / RECETTE
# Copier en ".env.staging" (jamais commité) et renseigner les vraies valeurs.
# Chargé avec : docker compose -p cesizen-staging --env-file .env.staging ...
#
# Le nom de projet Compose (-p cesizen-staging) isole complètement cette
# stack de la production : conteneurs, réseau et volume de base de données
# séparés, même si les noms de service (db/backend/frontend) sont les mêmes
# dans docker-compose.yml.

# Même IP que la prod, mais port différent -> URL publique différente.
PUBLIC_URL=http://change-me:8080
FRONTEND_PORT=8080

# Base de données — des identifiants DIFFÉRENTS de la prod (même si le nom
# logique est identique, c'est un volume/conteneur totalement séparé).
DB_NAME=cesizen
DB_USER=cesizen_app
DB_PASSWORD=change-me-staging-password

# Backend — secret JWT différent de la prod (des jetons émis en staging ne
# doivent pas être valides en prod, et inversement).
JWT_SECRET=change-me-staging-64-plus-random-characters

# Registre d'images
GHCR_OWNER=chambonbcesi
# "staging" = dernière image construite depuis la branche staging
IMAGE_TAG=staging
