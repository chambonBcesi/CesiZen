# Variables pour docker-compose.yml — ENVIRONNEMENT DE PRODUCTION
# Copier en ".env" (jamais commité, déjà exclu par .gitignore) et renseigner
# les vraies valeurs. Chargé avec : docker compose -p cesizen --env-file .env ...

# URL publique complète (avec le port si différent de 80) — pas de nom de
# domaine pour l'instant, donc juste l'IP.
PUBLIC_URL=http://change-me
FRONTEND_PORT=80

# Base de données
DB_NAME=cesizen
DB_USER=cesizen_app
DB_PASSWORD=change-me-strong-random-password

# Backend
JWT_SECRET=change-me-64-plus-random-characters

# Registre d'images (GitHub Container Registry)
GHCR_OWNER=chambonbcesi
# "latest" = dernière image de production publiée par la CI depuis "main"
IMAGE_TAG=latest
